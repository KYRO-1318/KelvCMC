APP_NAME=KelvCMC
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

SESSION_DRIVER=array
SESSION_ENCRYPT=false
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="test@example.com"
MAIL_FROM_NAME="KelvCMC Tests"

KELVCMC_BRAND_NAME=KelvCMC
KELVCMC_CURRENCY=EUR
API_ENABLED=true
KELVCMC_FORCE_2FA_ADMINS=false
BCRYPT_ROUNDS=4
