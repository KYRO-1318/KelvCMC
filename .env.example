APP_NAME="KelvCMC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------
# KelvCMC branding & billing defaults
# ------------------------------------------------------------------
KELVCMC_BRAND_NAME="KelvCMC"
KELVCMC_BRAND_TAGLINE="Cloud Management Center"
KELVCMC_CURRENCY=EUR
KELVCMC_DEFAULT_TAX_RATE=20
KELVCMC_BILLING_DAYS_BEFORE_RENEWAL=7
KELVCMC_SUSPEND_GRACE_DAYS=3
KELVCMC_TERMINATE_GRACE_DAYS=14

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kelvcmc
DB_USERNAME=kelvcmc
DB_PASSWORD=

# ------------------------------------------------------------------
# Session / Cache / Queue
# ------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis (background tasks, cache, sessions on production)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@kelvcmc.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Filesystem
# ------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Payment gateways — fill in the ones you enable
# ------------------------------------------------------------------
GATEWAY_STRIPE_ENABLED=false
GATEWAY_STRIPE_SECRET_KEY=
GATEWAY_STRIPE_WEBHOOK_SECRET=

GATEWAY_PAYPAL_ENABLED=false
GATEWAY_PAYPAL_CLIENT_ID=
GATEWAY_PAYPAL_SECRET=
GATEWAY_PAYPAL_SANDBOX=true

GATEWAY_MOLLIE_ENABLED=false
GATEWAY_MOLLIE_API_KEY=

GATEWAY_COINBASE_ENABLED=false
GATEWAY_COINBASE_API_KEY=
GATEWAY_COINBASE_WEBHOOK_SECRET=

GATEWAY_BANKTRANSFER_ENABLED=true
GATEWAY_BANKTRANSFER_DETAILS="KelvCMC SARL\nIBAN: FR76 0000 0000 0000 0000 0000 000\nBIC: AGRIFRPPXXX\nReference: invoice number"

GATEWAY_CREDIT_ENABLED=true

# ------------------------------------------------------------------
# Hosting integrations — Plesk
# ------------------------------------------------------------------
PLESK_ENABLED=false
PLESK_HOST=
PLESK_PORT=8443
PLESK_USERNAME=
PLESK_PASSWORD=
PLESK_VERIFY_SSL=false

# ------------------------------------------------------------------
# Hosting integrations — Pterodactyl
# ------------------------------------------------------------------
PTERODACTYL_ENABLED=false
PTERODACTYL_URL=
PTERODACTYL_API_KEY=

# ------------------------------------------------------------------
# Hosting integrations — Proxmox
# ------------------------------------------------------------------
PROXMOX_ENABLED=false
PROXMOX_URL=
PROXMOX_USER=
PROXMOX_TOKEN_NAME=
PROXMOX_TOKEN_VALUE=
PROXMOX_VERIFY_SSL=false

# ------------------------------------------------------------------
# DNS providers — Cloudflare / PowerDNS
# ------------------------------------------------------------------
CLOUDFLARE_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

POWERDNS_ENABLED=false
POWERDNS_URL=
POWERDNS_API_KEY=

# ------------------------------------------------------------------
# API
# ------------------------------------------------------------------
API_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=60
