#!/usr/bin/env php
<?php

use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Fail fast with a clear message when Composer dependencies are missing.
// The vendor directory is generated by Composer and must never be created
// manually. Checked before any other side effects (dirs, .env).
if (! is_file($autoload = __DIR__.'/vendor/autoload.php')) {
    fwrite(STDERR, PHP_EOL
        .'  [kelvcmc] Dépendances PHP non installées.'.PHP_EOL
        .'  Le fichier vendor/autoload.php est introuvable.'.PHP_EOL
        .'  Depuis la racine du projet, exécutez :  composer install'.PHP_EOL
        .PHP_EOL);
    exit(1);
}

// Ensure storage directories exist before Laravel boots.
// On a fresh clone (Plesk, git clone) these directories are absent and
// Laravel's Compiler will throw "Please provide a valid cache path" when
// composer's post-autoload-dump fires.
foreach ([
    '/storage/framework/cache/data',
    '/storage/framework/sessions',
    '/storage/framework/views',
    '/storage/logs',
    '/storage/app/private',
    '/storage/app/public',
    '/bootstrap/cache',
] as $dir) {
    $path = __DIR__.$dir;
    if (! is_dir($path)) {
        @mkdir($path, 0775, true);
    }
}

// Prepare a fresh checkout for the CLI installer before Laravel boots.
$environmentFile = __DIR__.'/.env';
if (! is_file($environmentFile) && is_file(__DIR__.'/.env.example')) {
    copy(__DIR__.'/.env.example', $environmentFile);
}
if (is_file($environmentFile)) {
    $environment = (string) file_get_contents($environmentFile);
    if (! preg_match('/^APP_KEY=.+$/m', $environment)) {
        $key = 'base64:'.base64_encode(random_bytes(32));
        $environment = (string) preg_replace('/^APP_KEY=.*$/m', 'APP_KEY='.$key, $environment, 1, $count);
        if ($count === 0) {
            $environment = rtrim($environment).PHP_EOL.'APP_KEY='.$key.PHP_EOL;
        }
        file_put_contents($environmentFile, $environment, LOCK_EX);
    }
}

// Register the Composer autoloader (already verified above).
require $autoload;

// Bootstrap Laravel and handle the command.
$status = (require_once __DIR__.'/bootstrap/app.php')
    ->handleCommand(new ArgvInput);

exit($status);
